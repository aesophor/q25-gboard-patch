type OVERLAY

# Q25 / BlackBerry Q20 layout, with the ALT modifier taken out of the
# framework's latching machinery.
#
# The physical ALT key reports scancode 56. Left as KEYCODE_ALT_LEFT it feeds
# MetaKeyKeyListener's latch state machine, and that latch is the single root
# cause of every problem this file exists to solve:
#
#   - a latched ALT makes BaseKeyListener.backspace() delete the whole line;
#   - the latch is stored as spans on the Editable, so it is invisible in
#     KeyEvent.getMetaState() -- confirmed in logcat, where DEL arrives with
#     meta=0x0 while the editor still believes ALT is down;
#   - because the editor passes that augmented meta state to getUnicodeChar(),
#     an "alt:" character entry fires and inserts an invisible U+0008 into
#     fields that do not treat it as a backspace (the rename dialog in Google
#     Files, for one).
#
# Remapping scancode 56 to KEYCODE_FUNCTION sidesteps all of it: FUNCTION is a
# plain held modifier that MetaKeyKeyListener does not track, so no latch can
# ever form. Verified in logcat as
#     DOWN KEYCODE_FUNCTION code=119 scan=56 meta=0x8
#     DOWN KEYCODE_E        code=33  scan=18 meta=0x8
# where 0x8 is META_FUNCTION_ON.
#
# The symbol layer therefore moves from "alt:" to "fn:". Holding the ALT key
# and pressing a letter types the same symbol it always did; only the selector
# name changed. The one thing lost is tap-ALT-then-press, which is the latch
# itself.
#
# Generated from the device's own /system/usr/keychars/Q25_keyboard.kcm, so the
# symbol table is the stock one, not a reconstruction.
map key 56 FUNCTION

# The keyboard has no period key -- the hardware key list contains no KEY_DOT,
# so KEYCODE_PERIOD is never generated and Gboard's ALT+period shortcut (emoji
# picker) is unreachable. "." exists only as a character on a symbol layer.
#
# A is therefore remapped to report KEYCODE_PERIOD. The block below still gives
# it 'a', 'A' and '*', so typing is unchanged -- only the keycode differs. SYM is
# KEYCODE_ALT_RIGHT, so SYM+A is a genuine ALT+PERIOD and opens the emoji picker.
#
# Do NOT move this to a key the lockscreen PIN uses. The keycode remap applies
# device-wide, but the lockscreen resolves digits through the "number:" behavior
# and does not see this overlay, so the remapped key goes dead there while every
# other PIN key keeps working. F was tried and failed exactly this way.
# Gboard honouring ALT+period was verified directly, by temporarily putting
# PERIOD on S.
#
# The choice of key is constrained by the keyboard firmware, which handles parts
# of the SYM layer itself, below Android. With SYM held (getevent on the
# Q25_keyboard device, MSC_SCAN carrying the letter's ASCII):
#   pass through: A C D F I N O P Q S T U V W
#   swallowed, no EV_KEY at all: E M R X Z
#   remapped by firmware: B->Down G->Left H->Home J->Right Y->Up
#                         K->VolumeUp L->VolumeDown, and $ -> Mute
# So SYM+E, the obvious mnemonic, cannot work at any level above the firmware.
map key 30 PERIOD

key PERIOD {
    label:                              'A'
    base:                               'a'
    shift, capslock:                    'A'
    shift+capslock:                     'a'
    fn:                                 '*'
}

key B {
    label:                              'B'
    base:                               'b'
    shift, capslock:                    'B'
    shift+capslock:                     'b'
    fn:                                 '!'
}

key C {
    label:                              'C'
    number:                             '9'
    base:                               'c'
    shift, capslock:                    'C'
    fn:                                 '9'
    shift+capslock:                     'c'
}

key D {
    label:                              'D'
    number:                             '5'
    base:                               'd'
    shift, capslock:                    'D'
    shift+capslock:                     'd'
    fn:                                 '5'
}

key E {
    label:                              'E'
    number:                             '2'
    base:                               'e'
    shift, capslock:                    'E'
    fn:                                 '2'
    shift+capslock:                     'e'
}

key F {
    label:                              'F'
    number:                             '6'
    base:                               'f'
    shift, capslock:                    'F'
    shift+capslock:                     'f'
    fn:                                 '6'
}

key G {
    label:                              'G'
    base:                               'g'
    shift, capslock:                    'G'
    shift+capslock:                     'g'
    fn:                                 '/'
}

key H {
    label:                              'H'
    base:                               'h'
    shift, capslock:                    'H'
    shift+capslock:                     'h'
    fn:                                 ':'
}

key I {
    label:                              'I'
    base:                               'i'
    shift, capslock:                    'I'
    fn:                                 '-'
    shift+capslock:                     'i'
}

key J {
    label:                              'J'
    base:                               'j'
    shift, capslock:                    'J'
    shift+capslock:                     'j'
    fn:                                 ';'
}

key K {
    label:                              'K'
    base:                               'k'
    shift, capslock:                    'K'
    shift+capslock:                     'k'
    fn:                                 '\''
}

key L {
    label:                              'L'
    base:                               'l'
    shift, capslock:                    'L'
    shift+capslock:                     'l'
    fn:                                 '"'
}

key M {
    label:                              'M'
    base:                               'm'
    shift, capslock:                    'M'
    shift+capslock:                     'm'
    fn:                                 '.'
}

key N {
    label:                              'N'
    base:                               'n'
    shift, capslock:                    'N'
    fn:                                 ','
    shift+capslock:                     'n'
}

key O {
    label:                              'O'
    base:                               'o'
    shift, capslock:                    'O'
    shift+capslock:                     'o'
    fn:                                 '+'
}

key P {
    label:                              'P'
    base:                               'p'
    shift, capslock:                    'P'
    shift+capslock:                     'p'
    fn:                                 '@'
}

key Q {
    label:                              'Q'
    base:                               'q'
    shift, capslock:                    'Q'
    shift+capslock:                     'q'
    fn:                                 '#'
}

key R {
    label:                              'R'
    number:                             '3'
    base:                               'r'
    shift, capslock:                    'R'
    shift+capslock:                     'r'
    fn:                                 '3'
}

key S {
    label:                              'S'
    number:                             '4'
    base:                               's'
    shift, capslock:                    'S'
    fn:                                 '4'
    shift+capslock:                     's'
}

key T {
    label:                              'T'
    base:                               't'
    shift, capslock:                    'T'
    shift+capslock:                     't'
    fn:                                 '('
}

key U {
    label:                              'U'
    base:                               'u'
    shift, capslock:                    'U'
    shift+capslock:                     'u'
    fn:                                 '_'
}

key V {
    label:                              'V'
    base:                               'v'
    shift, capslock:                    'V'
    shift+capslock:                     'v'
    fn:                                 '?'
}

key W {
    label:                              'W'
    number:                             '1'
    base:                               'w'
    shift, capslock:                    'W'
    shift+capslock:                     'w'
    fn:                                 '1'
}

key X {
    label:                              'X'
    number:                             '8'
    base:                               'x'
    shift, capslock:                    'X'
    shift+capslock:                     'x'
    fn:                                 '8'
}

key Y {
    label:                              'Y'
    base:                               'y'
    shift, capslock:                    'Y'
    shift+capslock:                     'y'
    fn:                                 ')'
}

key Z {
    label:                              'Z'
    number:                             '7'
    base:                               'z'
    shift, capslock:                    'Z'
    shift+capslock:                     'z'
    fn:                                 '7'
}

key SPACE {
    label:                              ' '
    number:                             ' '
    base:                               ' '
    shift:                              ' '
    fn:                                 '\uef01'
    shift+fn:                           '\uef01'
}

key ENTER {
    label:                              '\n'
    number:                             '\n'
    base:                               '\n'
    shift:                              '\n'
    fn:                                 '\n'
    shift+fn:                           '\n'
}

key 0 {
    label:                              '0'
    number:                             '0'
    base:                               '0'
    shift:                              '0'
    fn:                                 '0'
    shift+fn:                           '0'
}

# The physical "$" key reports scancode 41 as KEYCODE_GRAVE (device .kl:
# "key 41    GRAVE"). Q25_keyboard.kcm defines no GRAVE block, so the lookup
# fell through to Generic.kcm, which types a backtick -- hence the mismatch
# between the printed legend and what appears.
#
# base types the "$" that is printed on the key. Backtick and tilde stay
# reachable on the ALT (FUNCTION) and shift layers rather than being lost.
key GRAVE {
    label:                              '$'
    base:                               '$'
    shift:                              '~'
    fn:                                 '`'
    fn+shift:                           '\u0303'
}
